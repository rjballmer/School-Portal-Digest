{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/school-portal-digest/config.schema.json",
  "title": "School Portal Digest config",
  "type": "object",
  "additionalProperties": true,
  "required": ["portal", "family", "digest", "privacy"],
  "properties": {
    "initializedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "portal": {
      "type": "object",
      "required": ["name", "loginUrl", "homeUrl", "browserProfile", "auth"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "loginUrl": { "type": "string", "format": "uri" },
        "homeUrl": { "type": "string", "format": "uri" },
        "browserProfile": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "required": ["mode", "secretRef", "onAuthExpired"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["browser-session", "official-oauth", "keychain", "env-token", "manual-refresh"]
            },
            "modeOptions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "secretRef": { "type": ["string", "null"] },
            "onAuthExpired": { "type": "string", "enum": ["stop-and-report", "manual-refresh"] }
          }
        }
      }
    },
    "family": {
      "type": "object",
      "required": ["children", "calendarWriteMode"],
      "properties": {
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "portalAliases", "calendarName"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "portalAliases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "calendarName": { "type": "string", "minLength": 1 }
            }
          }
        },
        "calendarWriteMode": {
          "type": "string",
          "enum": ["recommend-only", "write-with-confirmation", "write-auto"]
        },
        "calendarWriteModeOptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "digest": {
      "type": "object",
      "required": ["cadence", "deliveryMode", "maxRetentionDays"],
      "properties": {
        "cadence": {
          "type": "string",
          "enum": ["on-demand", "post-school-day", "daily", "weekday-morning", "weekly"]
        },
        "deliveryMode": {
          "type": "string",
          "enum": ["announce", "file-only", "none"]
        },
        "maxRetentionDays": { "type": "integer", "minimum": 1 },
        "suppressCategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actionableCategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "calendarCategories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["redactNamesInSharedOutputs", "storeRawPortalText", "avoidScreenshots"],
      "properties": {
        "redactNamesInSharedOutputs": { "type": "boolean" },
        "storeRawPortalText": { "type": "boolean" },
        "avoidScreenshots": { "type": "boolean" }
      }
    }
  }
}
