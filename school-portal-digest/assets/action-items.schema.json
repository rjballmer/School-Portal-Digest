{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/school-portal-digest/action-items.schema.json",
  "title": "School Portal Digest action items",
  "type": "object",
  "additionalProperties": true,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "status", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "child": { "type": "string" },
          "source": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "completed", "needs-review", "dismissed"]
          },
          "firstSeen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "lastSeen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "eventDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "completedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
